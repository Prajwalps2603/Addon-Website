# Copy to server/.env and fill in what you have. Everything is optional in development.

PORT=4000
# The public address of the site, used in emails, link previews and the sitemap.
PUBLIC_URL=http://localhost:5173
# Long random string. Required in production.
JWT_SECRET=
# development (default) or production. Production refuses to start without JWT_SECRET and your own ADMIN_PASSWORD.
NODE_ENV=development
# SQLite database file (relative to server/). Keep it on a persistent disk in production.
DB_PATH=data/addon.db
# Where uploaded photos are stored (relative to server/). Keep it on a persistent disk in production.
UPLOADS_DIR=uploads
# The built storefront the server sends to visitors (relative to server/).
CLIENT_DIST=../client/dist

# The first admin account, created when the database is seeded.
ADMIN_EMAIL=admin@addon.local
ADMIN_PASSWORD=ChangeMe@123

# Razorpay (cards, UPI, netbanking). Leave blank to hide the Razorpay option.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Outgoing email. Leave blank to log emails to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
