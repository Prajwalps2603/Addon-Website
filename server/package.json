{
  "name": "addon-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.13.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/index.js",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/seed/run.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "nodemailer": "10.6.0",
    "razorpay": "2.9.8",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
